<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="@dimen/detail_toolbar_height"
            android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false" android:gravity="top"
                android:paddingStart="@dimen/detail_content_padding" android:paddingEnd="@dimen/detail_content_padding"
                android:paddingTop="8dp" android:paddingBottom="16dp">
                <FrameLayout android:id="@+id/hero" android:layout_width="@dimen/detail_poster_width"
                    android:layout_height="@dimen/detail_poster_height" android:background="@color/panel">
                    <ImageView android:id="@+id/cover" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="fitCenter"
                        android:contentDescription="@string/film_cover" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
                    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="@dimen/detail_title_size" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/metadata" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textSize="@dimen/detail_metadata_size"
                        android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/genres" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="@dimen/detail_metadata_size"
                        android:textColor="@color/accent" />
                    <Button android:id="@+id/play" android:layout_width="240dp" android:layout_height="@dimen/detail_play_height"
                        android:layout_marginTop="12dp" android:background="@drawable/detail_play_button"
                        android:textColor="#101010" android:textSize="16sp" android:textStyle="bold" android:text="@string/play" />
                    <View android:id="@+id/plotHeading" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <cn.awbz.davplayer.ui.InlinePlotView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textSize="14sp" android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary" android:maxLines="3" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="@dimen/detail_content_padding"
                android:paddingEnd="@dimen/detail_content_padding">
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" android:textSize="@dimen/detail_metadata_size" />
                <LinearLayout android:id="@+id/seasons" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <LinearLayout android:id="@+id/facts" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/detail_toolbar_height"
        android:layout_gravity="top" android:padding="@dimen/detail_toolbar_padding"
        android:gravity="center_vertical" android:background="@drawable/player_top_scrim">
        <ImageButton android:id="@+id/back" style="@style/PlayerIconButton" android:contentDescription="@string/back" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/refresh" style="@style/PlayerIconButton" android:contentDescription="@string/refresh_work" />
    </LinearLayout>
</FrameLayout>

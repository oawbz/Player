<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="6dp"
    android:background="@drawable/focus_card" android:focusable="true" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/poster_image_height"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/browse_all_panel">
        <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/browse_category"
            android:textSize="13sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="@dimen/poster_title_height"
        android:paddingTop="8dp" android:text="@string/browse_all" android:textSize="16sp"
        android:textColor="@color/text_primary" android:maxLines="2" />
</LinearLayout>

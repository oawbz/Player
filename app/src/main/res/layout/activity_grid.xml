<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/back" style="@style/PlayerIconButton" android:contentDescription="返回" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="24sp" android:padding="8dp" />
        <ImageButton android:id="@+id/refresh" style="@style/PlayerIconButton" android:contentDescription="刷新" android:padding="15dp" android:background="@drawable/quiet_icon_button" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/text_secondary" />
    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:numColumns="auto_fit" android:columnWidth="144dp" android:horizontalSpacing="12dp" android:verticalSpacing="12dp" android:stretchMode="columnWidth" android:clipToPadding="false" android:padding="4dp" android:listSelector="@drawable/focus_card" />
</LinearLayout>
